@startuml architecture
!theme plain

<style>
root {
    FontName Helvetica, Arial, sans-serif
    FontSize 12
    Shadowing 0
}
element {
    RoundCorner 8
}
package {
    BackgroundColor #F8F9FA
    LineColor #2C3E50
    FontColor #2C3E50
    FontStyle bold
    Padding 5
}
component {
    BackgroundColor #FFFFFF
    LineColor #34495E
    Padding 2
    Margin 5
}
database {
    BackgroundColor #EBF5FB
    LineColor #2980B9
    Padding 5
}
arrow {
    LineColor #2980B9
}
note {
    Padding 5
}
</style>

' Налаштування рушія Graphviz для мінімізації відступів
skinparam componentStyle uml2
skinparam nodesep 15
skinparam ranksep 20

actor "Гість (Клієнт)" as Customer #D4EFDF
actor "Персонал (Бариста/Адмін)" as Barista #FCF3CF

package "Клієнтський рівень (Vanilla JS, HTML5, CSS3)" {
    component "Вебзастосунок (SPA)" as SPA {
        component "Каталог меню\n(Фільтри, фото, ціни)" as MenuUI
        component "Кошик\n(Зміна кількості, тайм-слот)" as CartUI
        component "Замовлення\n(Історія, живий трекінг)" as OrdersUI
        component "Панель бариста\n(Стоп-лист, жива черга)" as AdminUI
        component "HTTP Клієнт API\n(Fetch, Bearer, помилки)" as ApiClient
    }
}

package "Серверний рівень (Python 3.11+ / FastAPI)" {
    portin "Gateway (/api/v1)" as Gateway
    
    component "Безпека (app/core/security)" as SecurityLayer {
        component "JWT (HS256, 60хв)" as JWTModule
        component "Bcrypt" as BcryptModule
        component "RBAC Dependency" as RBACModule
    }
    component "Маршрутизація & DTO (app/api/v1)" as ApiLayer {
        component "Routers: Auth, Menu, Orders" as Routers
        component "Pydantic v2 DTOs (Валідація)" as DTOValidation
    }
    component "Бізнес-логіка (app/services)" as ServiceLayer {
        component "AuthService (Реєстрація, вхід)" as AuthService
        component "MenuService (Страви, стоп-лист)" as MenuService
        component "OrderService (Розрахунок, State)" as OrderService
    }
    component "Репозиторії (app/repositories)" as RepoLayer {
        component "UserRepo, MenuRepo, OrderRepo" as Repos
    }
}

package "Рівень збереження даних" {
    database "PostgreSQL 16 (Том: coffee_shop_pgdata)" as Database {
        folder "Реляційні таблиці (3NF)" {
            component "users"
            component "categories"
            component "menu_items"
            component "orders"
            component "order_items"
        }
    }
}

Customer --> MenuUI : Перегляд
Customer --> CartUI : Збір кошика
Customer --> OrdersUI : Трекінг
Barista --> AdminUI : Черга & Стоп-лист

MenuUI --> ApiClient
CartUI --> ApiClient
OrdersUI --> ApiClient
AdminUI --> ApiClient

ApiClient --> Gateway : HTTPS/JSON (Bearer token)
Gateway --> RBACModule : Перевірка
RBACModule --> ApiLayer : Авторизація
ApiLayer --> ServiceLayer : DTO (чисті дані)
ServiceLayer --> RepoLayer : Доменні методи
RepoLayer --> Database : SQL (ACID)

note right of ServiceLayer
  <b>Інваріант:</b> Сервісний шар містить лише
  доменну логіку, без імпортів FastAPI/Starlette.
end note

note bottom of Database
  <b>Персистентність:</b> Дані на томі pgdata,
  запобігає втраті при рестарті контейнерів.
end note
@enduml