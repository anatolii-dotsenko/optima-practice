# Environment Configuration Example
PROJECT_NAME="Coffee Shop Online Ordering API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security (Generate a secure key with: openssl rand -hex 32)
SECRET_KEY="changeme-generate-a-secure-random-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="coffeeshop"
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/coffeeshop"

# CORS Configuration (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"
